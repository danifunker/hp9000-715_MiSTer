f0005d84 st41087_fail
f0005d98 st4108a_carry_imm_traps      # ADDC/SUBB, ADDIL, COMCLR, ADDIO (trap 12), SUBT (trap 13)
f0005f10 st4108b_cr_rctr_iiaq_rfi     # CCR/RCTR/IVA/IPSW, RCTR -4 rule, BREAK IIR, RFI with PSW.N
