f0006524 st41083_patterns
f0006540 st4108d_dual_issue_timing    # selftest2, only if CPU rev != 0; CR16 deltas 11/9/7/6
f0006694 st4108d_timed_kernel         # runs at phys 0xB4 from the I-cache
f00066d0 st42091_cache_addr_lines     # address lines / aliasing, I/D separation
f0006de0 st4209f_cache_ram_patterns   # fails report 0x42092 (I) / 0x42093 (D)
f0006d5c cache_err_fmt10
f0007100 st4209f_resident_l2          # runs from I-cache at 0
f0007458 st4209f_tag_patterns         # data; complement at f0007484
f00074b0 st4209f_data_patterns        # data; complement at f0007508
f0007560 st4209f_resident_l1          # runs from I-cache at 0: L1 LFSR test
f000786c l2ic_load                    # copy [r26,r25) into L2 I-cache at phys r24 (WI2D, SET_TAG, WI2T); link r31
f00078a8 l2ic_load_loop
f0007894 l2ic_purge                   # fice over the loaded lines; link r31
f0007934 cache_err_dump               # chassis codes r10..r21 (count r9), 0.75 s apart
f0007a3c cache_err_fmt8
f0007a8c l2ic_load_bytes              # byte-lane variant (ldb stride 4), link rp
f0007af0 st42090_cache_datapath_walk  # walking 1/0 through L2-D tag/data and L1
f0007e68 cache_err_fmt12
f0007ef8 st42096_cache_init           # all L2 lines tag 0xF0000400, L1 cleared
f0007f3c cache_invalidate_all
f0008080 st42095_cache_parity_detect  # flipped bits with stale parity -> DR0 bits 6/8, PARERR
f00084c0 st42094_cache_hit_compare    # real ldw/fetch hits per RPN bit, L1 over L2
f0009000 test_ivt                     # test-time IVA (dp ^= 1<<(31-n))
f00093a0 tivt_skip_rfi                # IIAOQ <- front+4/front+8, rfi
f00093b4 tivt_restore_rfi
f0009414 tivt_clr_ipsw_i
